{
  "name": "caspian-pro-server",
  "private": true,
  "version": "1.2.0",
  "description": "Caspian Pro API server: tickets, notifications, OTP login, parking, web push",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "admin": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "typescript": "^6.0.3"
  }
}
