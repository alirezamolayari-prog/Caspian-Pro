# Caspian Pro server settings. Copy to .env (never commit .env) and fill in.
# `npm start` reads this file automatically.

PORT=8787
# Database and uploaded photos. Back up this folder.
DATA_DIR=./data
# Built web app (run `npm run build:server` in the repo root first).
STATIC_DIR=../dist

# Password for the management panel at /admin. Use a long random value.
ADMIN_TOKEN=

# SMS for login codes: console (prints to the log, for testing) or kavenegar.
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
# Kavenegar "verify lookup" template with %token% (recommended: delivered faster, not filtered).
KAVENEGAR_TEMPLATE=
SMS_SENDER=
# Phones that get an SMS when a tenant presses the emergency button (comma separated).
SECURITY_PHONES=

# Web push. Create once with:  npm run admin -- vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@example.ir
# Android/Chrome push goes through Google (FCM), which is filtered in Iran.
# On a server inside Iran, set an HTTP proxy that can reach fcm.googleapis.com.
PUSH_PROXY=

# Parking software: mock (sample data) or http.
PARKING_PROVIDER=mock
PARKING_URL=
PARKING_TOKEN=
PARKING_REMINDER_DAYS=7

# Android app (TWA): package name and the SHA-256 of the signing certificate.
ANDROID_PACKAGE=ir.caspian.pro
ANDROID_SHA256=

# Only when the web app is hosted on a different domain than this server.
CORS_ORIGINS=
